{
  "compiled_rules": [
    {
      "id": "RULE_APPROVED_VENDOR",
      "source_doc": "finance_policy.md",
      "source_quote": "Every invoice submitted for payment must originate from an authorized vendor on the Corporate Approved Vendor List",
      "condition": {
        "field": "vendor_status",
        "op": "==",
        "value": "active"
      },
      "action": "pass",
      "reason": "Invoice vendor must be an active approved vendor. Unapproved vendors must be rejected."
    },
    {
      "id": "RULE_PO_VARIANCE_TOLERANCE",
      "source_doc": "finance_policy.md",
      "source_quote": "If the total invoice amount matches the PO amount exactly, or differs by no more than 2.00%, the invoice is approved for automated bill creation. If the variance ... exceeds 2.00%, automated bill creation is strictly prohibited ... explicit Human Manager Approval is required",
      "condition": {
        "field": "variance_pct",
        "op": "<=",
        "value": 2.0
      },
      "action": "pass",
      "reason": "Invoice variance over PO amount must be within 2.0% tolerance, else requires manager approval."
    },
    {
      "id": "RULE_MANAGER_THRESHOLD",
      "source_doc": "finance_policy.md",
      "source_quote": "Any invoice where the total bill amount equals or exceeds $5,000.00 USD requires mandatory Finance Director Approval",
      "condition": {
        "field": "total_amount",
        "op": "<",
        "value": 5000.00
      },
      "action": "pass",
      "reason": "Transactions $5,000.00 USD and above require Finance Director authorization."
    },
    {
      "id": "RULE_DUPLICATE_PREVENTION",
      "source_doc": "finance_policy.md",
      "source_quote": "Under no circumstances may an invoice with an identical Invoice Number and Vendor ID be registered more than once",
      "condition": {
        "field": "is_duplicate",
        "op": "==",
        "value": false
      },
      "action": "pass",
      "reason": "Duplicate invoice numbers for the same vendor are strictly prohibited."
    }
  ],
