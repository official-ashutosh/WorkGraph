# WorkGraph Configuration
# By default, runs in offline deterministic 'replay' mode (No API key needed!)
RECORD_REPLAY_MODE=replay

# Optional: Provide Anthropic or Gemini API key to run live model calls
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Mock App URLs
LEDGERONE_URL=http://127.0.0.1:8000
WORKGRAPH_PORT=8080
